source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "just-the-docs", "~> 0.10"

group :jekyll_plugins do
  gem "jekyll-asciidoc", "~> 3.0"
  # PlantUML (and other diagram types) inside AsciiDoc. The PlantUML jar
  # ships with asciidoctor-diagram-plantuml, so only a JRE is needed.
  gem "asciidoctor-diagram", "~> 3.0"
  gem "asciidoctor-diagram-plantuml"
  gem "jekyll-seo-tag"
end

gem "webrick", "~> 1.8"
