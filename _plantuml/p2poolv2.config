'
' Brand skin for every PlantUML diagram on the site, wired in through the
' `plantumlconfig` attribute in _config.yml. Same four colours as the
' site: Bitcoin Orange #F7931A, Black #0B0B0C, Near Black #121212, White.
' Orange carries structure (borders, arrows), white carries text, and
' shades are the four at reduced opacity (8-digit hex, alpha last).
' A diagram can still override any of this locally.

skinparam backgroundColor #0B0B0C
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontColor #FFFFFF
skinparam defaultFontSize 13
skinparam defaultMonospacedFontName "DejaVu Sans Mono"
skinparam ArrowColor #F7931A
skinparam ArrowFontColor #FFFFFFC7
skinparam ArrowThickness 1.2

skinparam default {
  BackgroundColor #121212
  BorderColor #F7931A
  FontColor #FFFFFF
}

skinparam note {
  BackgroundColor #121212
  BorderColor #FFFFFF8F
  FontColor #FFFFFFC7
}

skinparam sequence {
  LifeLineBorderColor #FFFFFF8F
  LifeLineBackgroundColor #121212
  ParticipantBackgroundColor #121212
  ParticipantBorderColor #F7931A
  ActorBackgroundColor #121212
  ActorBorderColor #F7931A
  GroupBackgroundColor #121212
  GroupBorderColor #FFFFFFC7
  GroupHeaderFontColor #FFFFFF
  DividerBackgroundColor #121212
  DividerBorderColor #FFFFFF8F
  BoxBackgroundColor #121212
  BoxBorderColor #FFFFFF66
}

skinparam activity {
  BackgroundColor #121212
  BorderColor #F7931A
  DiamondBackgroundColor #121212
  DiamondBorderColor #F7931A
  StartColor #F7931A
  EndColor #F7931A
  BarColor #F7931A
}

skinparam state {
  BackgroundColor #121212
  BorderColor #F7931A
  StartColor #F7931A
  EndColor #F7931A
}

skinparam class {
  BackgroundColor #121212
  BorderColor #F7931A
  HeaderBackgroundColor #121212
  AttributeFontColor #FFFFFFC7
  StereotypeFontColor #FFFFFF8F
}

skinparam stereotypeCBackgroundColor #F7931A
skinparam stereotypeIBackgroundColor #F7931A
skinparam stereotypeEBackgroundColor #F7931A
skinparam stereotypeABackgroundColor #F7931A

skinparam component {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam package {
  BackgroundColor #0B0B0C
  BorderColor #FFFFFF66
}

skinparam node {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam database {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam rectangle {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam cloud {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam actor {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam usecase {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam queue {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam frame {
  BackgroundColor #0B0B0C
  BorderColor #F7931A
}

skinparam folder {
  BackgroundColor #0B0B0C
  BorderColor #F7931A
}

skinparam artifact {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam agent {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam storage {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam card {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam collections {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam entity {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam boundary {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam control {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam hexagon {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam file {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam stack {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam interface {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam object {
  BackgroundColor #121212
  BorderColor #F7931A
}

skinparam partition {
  BackgroundColor #0B0B0C
  BorderColor #F7931A
}

skinparam swimlane {
  BackgroundColor #0B0B0C
  BorderColor #F7931A
}

skinparam legend {
  BackgroundColor #121212
  BorderColor #FFFFFF66
}

' Newer PlantUML draws sequence diagrams with its style engine, which
' ignores the lifeline, group and participant skinparams above. White at
' 40% was too faint as a thin dashed line on the black page: lifelines and
' the alt/else divider are white at 56%, group frames at 78%, so both stay
' visible while the orange arrows still lead.
<style>
sequenceDiagram {
  lifeLine {
    LineColor #FFFFFF8F
  }
  group {
    LineColor #FFFFFFC7
  }
  separator {
    LineColor #FFFFFF8F
  }
  participant {
    LineColor #F7931A
  }
  actor {
    LineColor #F7931A
  }
}
</style>
